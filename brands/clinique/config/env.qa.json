{
  "environment": "qa",
  "header": {
    "title": "Clinique Virtual Assistant",
    "subtitle": "Virtual Assistant for your website",
    "logoUrl": "",
    "showCloseButton": true
  },
  "aws": {
    "region": "us-east-1",
    "connectInstanceId": "YOUR_QA_CONNECT_INSTANCE_ID",
    "contactFlowId": "YOUR_QA_CONTACT_FLOW_ID",
    "apiGatewayEndpoint": "https://jgnx26szub.execute-api.eu-west-2.amazonaws.com/dev/startChat"
  },
  "widget": {
    "title": "Clinique",
    "subtitle": "We're here to help",
    "primaryColor": "#3F51B5",
    "secondaryColor": "#FF4081",
    "headerTextColor": "#FFFFFF",
    "fontFamily": "Arial, sans-serif"
  },
  "features": {
    "enableAttachments": true,
    "enableTypingIndicator": true,
    "enableReadReceipts": true,
    "enableSounds": false
  },
  "analytics": {
    "enabled": true,
    "trackingId": "QA-TRACKING-ID"
  }
}
